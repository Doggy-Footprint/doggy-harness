#!/usr/bin/env bash
set -euo pipefail

harness_git_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
harness_dir="$(dirname "$harness_git_dir")"

if command -v python3 >/dev/null 2>&1; then
  python3 "$harness_dir/git/warn_commit_message.py" "$1" || true
fi

. "$harness_git_dir/hook_dispatch.sh"
harness_dispatch commit-msg "$@"
